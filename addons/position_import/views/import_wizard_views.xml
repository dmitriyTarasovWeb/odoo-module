<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_position_import_wizard_form" model="ir.ui.view">
        <field name="name">position.import.wizard.form</field>
        <field name="model">position.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Position">
                <group>
                    <field name="api_token"/>
                </group>

                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_position_import_wizard" model="ir.actions.act_window">
        <field name="name">Import from API</field>
        <field name="res_model">position.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_position_import_api"
        name="Import from API"
        parent="menu_position_import_root"
        action="action_position_import_wizard"
        sequence="20"/>

</odoo>